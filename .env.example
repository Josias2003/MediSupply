# ─────────────────────────────────────────────────────────────────────
# MediSupply — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────

# MySQL Database Connection
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://medisupply:YourPassword123!@localhost:3306/medisupply

# JWT Secret — used to sign session tokens
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string-min-32-characters

# Server Port (default: 3000)
PORT=3000

# Node Environment
NODE_ENV=development

# ── Required by framework (can stay as-is for local dev) ──────────────
VITE_APP_ID=medisupply-local
VITE_OAUTH_PORTAL_URL=http://localhost:3000
OAUTH_SERVER_URL=http://localhost:3000
OWNER_OPEN_ID=local_admin

# SMTP Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_FAMILY=4
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="MediSupply Rwanda <your-email@example.com>"
APP_URL=http://localhost:3000
